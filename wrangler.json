{
  "name": "betterintra-remake",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-01",
  "kv_namespaces": [
    {
      "binding": "BETTER_INTRA_KV",
      "id": "225f0f647c59475798c118ed9b1dde59"
    }
  ],
  "d1_databases": [
    {
      "binding": "better_intra_d1",
      "database_name": "better-intra-d1",
      "database_id": "93d714a6-f83a-4aa3-be0e-3a09d6277035"
    }
  ],
  "vars": {
    "CLIENT_ID": "TO_FILL_42_APP_UID",
    "DISCORD_ENABLED": "false"
  },
  "triggers": {
    "crons": [
      "*/10 * * * *",
      "* * * * *",
      "0 22,4,10,16 * * *"
    ]
